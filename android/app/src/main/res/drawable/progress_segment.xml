<?xml version="1.0" encoding="utf-8"?>
<!-- One of the five segments: lit (activated) in the accent, the rest in the rail grey -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle"><solid android:color="@color/cody" /><corners android:radius="2dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/rail" /><corners android:radius="2dp" /></shape>
    </item>
</selector>
