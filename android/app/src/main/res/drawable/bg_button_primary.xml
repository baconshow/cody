<?xml version="1.0" encoding="utf-8"?>
<!-- The primary button: a 56 dp pill in the accent; pressed at 88 %, disabled as a dark pill -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33000000">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle"><solid android:color="@color/chip" /><corners android:radius="28dp" /></shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle"><solid android:color="@color/cody_pressed" /><corners android:radius="28dp" /></shape>
            </item>
            <item>
                <shape android:shape="rectangle"><solid android:color="@color/cody" /><corners android:radius="28dp" /></shape>
            </item>
        </selector>
    </item>
</ripple>
