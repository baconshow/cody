<?xml version="1.0" encoding="utf-8"?>
<!-- The switch's dot: 16 dp grey when off, 24 dp cream when on, inside a 26 x 32 thumb so the track stays 52 wide -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:width="26dp" android:height="32dp" android:left="1dp" android:right="1dp" android:top="4dp" android:bottom="4dp">
                <shape android:shape="oval"><solid android:color="@color/thumb_on" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:width="26dp" android:height="32dp" android:left="5dp" android:right="5dp" android:top="8dp" android:bottom="8dp">
                <shape android:shape="oval"><solid android:color="@color/dim" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
