<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Black like the mascot page; no app bar -->
    <style name="Theme.Cody" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:colorAccent">@color/cody</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/dim</item>
    </style>

    <!-- The moment between the icon and Chrome: black, nothing drawn, so the splash does the showing -->
    <style name="Theme.Cody.Launcher">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- The first run's type scale: the design's Roboto Flex, here the system's Roboto at the same weights -->
    <style name="Text">
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.Display">
        <item name="android:textSize">40sp</item>
        <item name="android:lineHeight">44sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:letterSpacing">-0.0125</item>
    </style>
    <style name="Text.Headline">
        <item name="android:textSize">28sp</item>
        <item name="android:lineHeight">34sp</item>
        <item name="android:letterSpacing">-0.009</item>
    </style>
    <style name="Text.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:lineHeight">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight">24sp</item>
        <item name="android:textColor">@color/dim</item>
    </style>
    <style name="Text.BodyInk">
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight">24sp</item>
    </style>
    <style name="Text.BodySmall">
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:textColor">@color/dim</item>
    </style>
    <style name="Text.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:lineHeight">16sp</item>
        <item name="android:textColor">@color/dim</item>
    </style>
    <style name="Text.Code">
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <!-- Status chip: 28 dp, radius 8, a 6 dp dot before the word; background, colour and dot are set in code -->
    <style name="Text.Chip">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/dim</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:drawablePadding">6dp</item>
    </style>

    <!-- Buttons: a 56 dp pill in the accent, a 56 dp outline, a 40 dp outline, a 48 dp line of text in the accent -->
    <style name="Button" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:minWidth">0dp</item>
    </style>
    <style name="Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/button_primary_text</item>
    </style>
    <style name="Button.Secondary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Button.Small">
        <item name="android:minHeight">40dp</item>
        <item name="android:background">@drawable/bg_button_small</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>
    <style name="Button.Text">
        <item name="android:minHeight">48dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textColor">@color/cody</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
