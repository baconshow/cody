<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Black like the mascot page; no app bar -->
    <style name="Theme.Cody" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:colorAccent">@color/cody</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/dim</item>
    </style>

    <!-- The moment between the icon and Chrome: black, nothing drawn, so the splash does the showing -->
    <style name="Theme.Cody.Launcher">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
