<?xml version="1.0" encoding="utf-8"?>
<!-- After Connect: Cody asleep and "Computer not found", or Cody happy in its light and "Hi! Cody is awake." -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="@dimen/result_head_width"
            android:layout_height="@dimen/result_head_height"
            android:layout_marginTop="@dimen/result_head_top"
            android:clipChildren="false">

            <View
                android:id="@+id/resultGlow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="-24dp"
                android:background="@drawable/glow_cody"
                android:visibility="invisible" />

            <io.github.baconshow.cody.CodyHead
                android:id="@+id/resultHead"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                app:eyes="asleep" />
        </FrameLayout>

        <TextView
            android:id="@+id/resultChip"
            style="@style/Text.Chip"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_chip_ok"
            android:drawableStart="@drawable/dot_ok"
            android:text="@string/connected"
            android:textColor="@color/ok_text"
            android:visibility="gone" />

        <TextView
            android:id="@+id/resultTitle"
            style="@style/Text.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:text="@string/not_found_title" />

        <TextView
            android:id="@+id/resultBody"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:text="@string/not_found_body" />

        <TextView
            android:id="@+id/resultAddress"
            style="@style/Text.Code"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_address_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/dim"
            android:textSize="13sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/resultPrimary"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="@string/try_again" />

        <Button
            android:id="@+id/openTailscale"
            style="@style/Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/open_tailscale" />

        <Button
            android:id="@+id/changeAddress"
            style="@style/Button.Text"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="@string/change_address" />
    </LinearLayout>
</ScrollView>
